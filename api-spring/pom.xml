<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>mx.uv.dsw</groupId>
  <artifactId>api-spring</artifactId>
  <version>0.4.0</version>
  <name>PR09 Monitoreo de huerto - API REST (P04, Web 3.0)</name>
  <description>Backend Spring Boot 2.7 / Java 11: API REST con JDBC sobre PostgreSQL para el cliente Angular.</description>

  <properties>
    <java.version>11</java.version>
        <!-- mismo driver que P02/P03; la version que administra Spring Boot 2.7.18 es anterior -->
        <postgresql.version>42.7.2</postgresql.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>1.7.0</springdoc.version>
  </properties>

  <dependencies>
    <!-- API REST con Tomcat embebido y Jackson -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- JdbcTemplate, transacciones y pool HikariCP; se conserva SQL parametrizado sobre el esquema existente -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Publica /v3/api-docs y /swagger-ui.html a partir del codigo; el contrato de referencia es docs/p04/openapi.yaml -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>api-spring</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
