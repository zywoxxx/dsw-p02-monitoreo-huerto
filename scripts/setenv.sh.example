#!/bin/sh
# Copiar a $CATALINA_HOME/bin/setenv.sh (Linux/macOS) y dar permisos: chmod +x setenv.sh
# Valores de LABORATORIO (coinciden con docker/docker-compose.yml). No usar credenciales reales.
export DB_URL="jdbc:postgresql://localhost:5436/huerto_db"
export DB_USER="huerto_app"
export DB_PASSWORD="huerto_dev"
export JAVA_OPTS="$JAVA_OPTS -Dfile.encoding=UTF-8"
