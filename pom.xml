<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>mx.uv.dsw</groupId>
  <artifactId>web2</artifactId>
  <version>0.3.0</version>
  <packaging>war</packaging>

  <name>PR09 Monitoreo de huerto o ambiente - Incremento P03 (web2-jsf)</name>
  <description>Aplicacion Web 2.0 con JSF 2.3 (Mojarra), PrimeFaces 12, CDI (Weld) sobre Tomcat 9 y PostgreSQL 16 con JDBC parametrizado.</description>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Familia javax: Tomcat 9 implementa Servlet 4.0 / EL 3.0 / JSP 2.3 -->
    <servlet.version>4.0.1</servlet.version>
    <mojarra.version>2.3.9</mojarra.version>
    <primefaces.version>12.0.0</primefaces.version>
    <weld.version>3.1.9.Final</weld.version>
    <annotation.version>1.3.2</annotation.version>
    <postgresql.version>42.7.2</postgresql.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!-- Servlet 4.0: lo provee Tomcat 9 -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>${servlet.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- JSF 2.3: API + implementacion Mojarra en un solo jar (Tomcat no trae Faces) -->
    <dependency>
      <groupId>org.glassfish</groupId>
      <artifactId>javax.faces</artifactId>
      <version>${mojarra.version}</version>
    </dependency>
    <!-- PrimeFaces 12 para javax (el artefacto sin classifier es la variante javax) -->
    <dependency>
      <groupId>org.primefaces</groupId>
      <artifactId>primefaces</artifactId>
      <version>${primefaces.version}</version>
    </dependency>
    <!-- CDI 2.0 para Tomcat: Weld Servlet incluye API e implementacion y se registra solo -->
    <dependency>
      <groupId>org.jboss.weld.servlet</groupId>
      <artifactId>weld-servlet-shaded</artifactId>
      <version>${weld.version}</version>
    </dependency>
    <!-- @PostConstruct / @Resource ya no vienen en el JDK 11 -->
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>${annotation.version}</version>
    </dependency>
    <!-- JAXB tampoco viene en el JDK 11: Mojarra lo usa (DatatypeConverter) al cifrar el flash en redirecciones -->
    <dependency>
      <groupId>javax.xml.bind</groupId>
      <artifactId>jaxb-api</artifactId>
      <version>2.3.1</version>
    </dependency>
    <!-- Driver JDBC de PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
    <!-- Pruebas unitarias de las reglas de validacion y autenticacion -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>web2</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.3.2</version>
      </plugin>
    </plugins>
  </build>
</project>
