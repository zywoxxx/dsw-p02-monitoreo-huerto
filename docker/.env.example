# Copiar a docker/.env solo si se desea cambiar los valores de laboratorio.
# NO versionar docker/.env (esta en .gitignore).
POSTGRES_DB=huerto_db
POSTGRES_USER=huerto_app
POSTGRES_PASSWORD=huerto_dev
POSTGRES_PORT=5436
# Puerto del equipo en el que nginx publica el cliente y la API (perfil "app")
WEB_PORT=80
# Secreto de firma del token (32 caracteres o mas). Si se deja vacio, la API genera uno al arrancar
JWT_SECRET=
